# Copy to .env to change the defaults (.env is not committed). Never put real secrets
# in .env.example. `npm run dashboard`, `npm run dashboard:start`, `npm test` and
# `docker compose` all read .env.

# Postgres used by `npm test`, `npm run migrate -w @lessonfolk/db`, `npm run progress:import`
# and the dashboard on your machine (it keeps the progress). Default: the `db` service of
# docker-compose.yml (start it with `docker compose up -d db`).
DATABASE_URL=postgres://lessonfolk:lessonfolk@127.0.0.1:5432/lessonfolk

# docker compose: password of the `db` service, and the ports on 127.0.0.1.
# If you change them, update DATABASE_URL above to match.
POSTGRES_PASSWORD=lessonfolk
LESSONFOLK_PORT=4321
LESSONFOLK_DB_PORT=5432

# --- Sign-in (docs/auth-dev.md) ---------------------------------------------------
# none:  no sign-in, one local learner. Refuses to start unless only 127.0.0.1 can reach it.
# oauth: sign in with GitHub and/or Google (the providers whose credentials are set below).
LESSONFOLK_AUTH=none

# docker compose only: the host address the app port is published on. The LESSONFOLK_AUTH=none
# check uses it, because inside the container the server listens on 0.0.0.0.
# LESSONFOLK_BIND=127.0.0.1

# oauth: the address people open in their browser. Callbacks go to
# <LESSONFOLK_BASE_URL>/api/auth/callback/github (or /google).
# LESSONFOLK_BASE_URL=http://localhost:4321

# oauth: a random secret of at least 32 characters that signs session cookies.
# Generate one with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# oauth: credentials of your OAuth apps. Set both values of a provider, or neither.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
