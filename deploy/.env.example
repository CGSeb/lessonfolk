# Copy to /opt/lessonfolk/.env on the server (chmod 600). Never commit the real file.
# The OAuth callbacks are explained in docs/auth-dev.md.

# The public domain, without https:// (its DNS record points at this server).
LESSONFOLK_DOMAIN=learn.example.com

# Password of the database (the database is not reachable from outside the server).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Password of the least-privilege database role (lessonfolk_app) the app runs as. Hex only (it is
# used in a URL). deploy.sh generates it when missing, so you can leave it out.
# Generate one with: openssl rand -hex 24
LESSONFOLK_APP_DB_PASSWORD=

# Signs session cookies, at least 32 characters. Keep it stable: changing it signs everybody out.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Production OAuth apps. Set both values of a provider, or neither.
# Callbacks: https://<domain>/api/auth/callback/github (or /google)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who runs this LessonFolk (a name, and a country: e.g. "Jane Doe, France"), shown on /privacy.
LESSONFOLK_OPERATOR=

# Who learners write to about their data (an email address or a page), shown on /privacy.
LESSONFOLK_PRIVACY_CONTACT=

# The law that governs the terms of use (e.g. "French law"), shown on /terms. Left empty, /terms states none.
LESSONFOLK_GOVERNING_LAW=

# Country or region where this server and its backups are, shown on /privacy (e.g. Canada).
LESSONFOLK_DATA_LOCATION=

# --- Admin dashboards (Umami, GlitchTip) ---------------------------------------------------------
# Never reachable from the internet. By default they listen on this server's 127.0.0.1, opened
# through an SSH tunnel (ssh -L <port>:127.0.0.1:<port> <user>@<server>, then http://localhost:<port>).
# ADMIN_ADDRESS makes them listen on another address of this server instead (then open
# http://<that address>:<port>). Docker publishes ports past the firewall: only set a private
# address that the internet cannot reach.
# ADMIN_ADDRESS=

# --- Audience measurement (Umami: no cookie, no IP address stored) --------------------------------
# deploy.sh generates both secrets when missing, so you can leave them out. Hex only.
# Generate one with: openssl rand -hex 24
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Id of the site in Umami. Until it is set, no page is measured. First deploy:
#   1. Open the Umami dashboard on port 3001 (UMAMI_PORT below changes it), as ADMIN_ADDRESS above says.
#   2. Sign in as admin / umami and change the password at once (Settings > Profile).
#   3. Settings > Websites > Add website (name LessonFolk, domain = LESSONFOLK_DOMAIN), then copy
#      its id from the website's settings and put it here. Then run ./deploy.sh latest (or redeploy).
UMAMI_WEBSITE_ID=
# UMAMI_PORT=3001

# Domain verification token of OpenAI's plugin directory, served as plain text at
# /.well-known/openai-apps-challenge. Leave empty otherwise.
OPENAI_APPS_CHALLENGE=

# Statistics older than 25 months are deleted by purge-analytics.sh. Run it from cron too, e.g.:
#   30 3 * * * /opt/lessonfolk/purge-analytics.sh >> /opt/lessonfolk/backups/purge.log 2>&1

# Optional off-server copy of the nightly backup (an rclone remote:path).
# BACKUP_REMOTE=

# --- Error monitoring (GlitchTip, on this server; see docs/privacy.md, "Error monitoring") ---------
# deploy.sh generates both secrets when missing, so you can leave them out. Hex only.
# Generate one with: openssl rand -hex 24
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=

# The app reports unexpected errors to GlitchTip on the internal network. Until this is set, nothing
# is reported. First deploy:
#   1. Open GlitchTip on port 3002 (GLITCHTIP_PORT below changes it), as ADMIN_ADDRESS above says.
#   2. Register: the first account is the only one that can be created. Create an organization and a
#      project (platform: Node.js), then copy the project's DSN from its settings.
#   3. Put the DSN here with its address replaced by the internal one, keeping the key and project number:
#        ERROR_REPORT_DSN=http://<key>@glitchtip:8000/<project number>
#      Then run ./deploy.sh latest (or redeploy).
#   4. In GlitchTip, add an alert (project > Alerts) and an uptime monitor on https://<domain>/ to be told
#      when the site is down.
ERROR_REPORT_DSN=
# GLITCHTIP_PORT=3002

# E-mail for the alerts: an SMTP URL and the sender. Without them, the e-mails are only written to
# GlitchTip's log (docker compose logs glitchtip).
# GLITCHTIP_EMAIL_URL=smtp://user:password@smtp.example.com:587
# GLITCHTIP_FROM_EMAIL=alerts@example.com
