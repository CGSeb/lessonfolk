{
  "name": "@lessonfolk/dashboard",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "start": "node --env-file-if-exists=../.env --experimental-strip-types --disable-warning=ExperimentalWarning scripts/serve.ts",
    "check": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.db.test.ts\"",
    "progress:import": "node --env-file-if-exists=../.env --experimental-strip-types --disable-warning=ExperimentalWarning scripts/import-progress.ts",
    "check:courses": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-courses.ts",
    "review:courses": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/review-courses.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@lessonfolk/core": "*",
    "@lessonfolk/db": "*",
    "@lessonfolk/mcp": "*",
    "astro": "^7.4.2",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
