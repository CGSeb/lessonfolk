---
// Inter is self-hosted: bundled from node_modules, no request to any font CDN.
import '@fontsource-variable/inter';
import '../styles/global.css';
import { t } from '../i18n/en';
import CopyButtons from '../components/CopyButtons.astro';
import LiveRefresh from '../components/LiveRefresh.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { signInHref } from '../lib/auth/redirect';

interface Props {
  /** Page name shown before the site name in the tab title. Omit for the site title alone. */
  title?: string;
  /** Meta description; defaults to the site description. */
  description?: string;
}

const { title, description = t('site.description') } = Astro.props;
const fullTitle = title ? t('site.titleTemplate', { page: title }) : t('site.title');

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Sign in / sign out, only when people sign in (LESSONFOLK_AUTH=oauth).
const { authMode, user } = Astro.locals;
const navItems = [
  { href: '/', label: t('nav.home'), current: path === '/' },
  { href: '/courses', label: t('nav.courses'), current: path === '/courses' || path.startsWith('/courses/') },
  { href: '/authors', label: t('nav.authors'), current: path === '/authors' || path.startsWith('/authors/') },
  { href: '/connect', label: t('nav.connect'), current: path === '/connect' },
  // The learner's own data: only for someone whose data it is.
  ...(user ? [{ href: '/account', label: t('nav.account'), current: path === '/account' || path.startsWith('/account/') }] : []),
];
const signInLink = signInHref(Astro.url);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply the saved light/dark choice before first paint (see ThemeToggle).
      try {
        const theme = localStorage.getItem('lessonfolk-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="wordmark" href="/" aria-label={t('a11y.homeLink')}>
          <svg class="wordmark__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <rect class="wordmark__tile" width="64" height="64" rx="16"></rect>
            <path
              class="wordmark__letter"
              d="M22 14 L22 46 L42 46"
              fill="none"
              stroke-width="7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path class="wordmark__spark" d="M43 13Q44.6 22.4 54 24Q44.6 25.6 43 35Q41.4 25.6 32 24Q41.4 22.4 43 13Z"></path>
          </svg>
          <span class="wordmark__text">{t('site.name')}</span>
        </a>
        <div class="site-header__actions">
          <nav aria-label={t('a11y.mainNav')}>
            <ul class="nav-list" role="list">
              {
                navItems.map((item) => (
                  <li>
                    <a class="nav-link" href={item.href} aria-current={item.current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          {
            authMode === 'oauth' &&
              (user ? (
                <form class="account" method="post" action="/sign-out" aria-label={t('auth.accountLabel')}>
                  <span class="account__name" title={user.email}>
                    {t('auth.signedInAs', { name: user.name || user.email })}
                  </span>
                  <button class="account__button" type="submit">
                    {t('auth.signOut')}
                  </button>
                </form>
              ) : (
                path !== '/sign-in' && (
                  <a class="account__button" href={signInLink}>
                    {t('auth.signIn')}
                  </a>
                )
              ))
          }
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main" class="container site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container stack" style="--stack-space: var(--space-2)">
        <p>{t('footer.about')}</p>
        <p>{t(authMode === 'oauth' ? 'footer.privacyAccount' : 'footer.privacy')}</p>
        <p>{t('footer.license')}</p>
      </div>
    </footer>
    <LiveRefresh />
    <CopyButtons />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  .container {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    box-shadow: var(--shadow-raised);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium); /* matches the logo files */
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-text);
  }

  .wordmark__mark {
    flex: none;
    width: 2rem;
    height: 2rem;
  }

  /* The logo colours are fixed brand values, the same in both themes. */
  .wordmark__tile {
    fill: var(--brand-indigo);
  }

  .wordmark__letter {
    stroke: var(--brand-white);
  }

  .wordmark__spark {
    fill: var(--brand-amber);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .nav-link:hover {
    background: var(--color-surface-sunken);
    color: var(--color-text);
  }

  .nav-link[aria-current='page'] {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }

  .account {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .account__name {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .account__button {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-weight: var(--weight-medium);
    text-decoration: none;
    cursor: pointer;
  }

  .account__button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .site-main {
    flex: 1;
    padding-block: clamp(var(--space-5), 6vw, var(--space-7)) var(--space-8);
  }

  .site-main:focus {
    outline: none;
    box-shadow: none;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-6);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
