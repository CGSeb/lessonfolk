---
// Fonts are self-hosted: bundled from node_modules, no request to any font CDN.
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
// Inter is for the wordmark only, as in the logo files.
import '@fontsource-variable/inter';
import '../styles/global.css';
import { t } from '../i18n/en';
import CopyButtons from '../components/CopyButtons.astro';
import LiveRefresh from '../components/LiveRefresh.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { signInHref } from '../lib/auth/redirect';
import { SHARE_IMAGE_ALT, SHARE_IMAGE_PATH, absoluteUrl, serializeJsonLd } from '../lib/seo';
import { siteOrigin } from '../lib/site-url';
import { currentRelease } from '../lib/version';

interface Props {
  /** Page name shown before the site name in the tab title. Omit for the site title alone. */
  title?: string;
  /** Meta description; defaults to the site description. */
  description?: string;
  /** Keep the page out of search results (pages for the signed-in learner, sign-in flow). */
  noindex?: boolean;
  /** Open Graph type: `website` (default) or `article`. */
  ogType?: 'website' | 'article';
  /** Schema.org data of the page, written as JSON-LD. */
  jsonLd?: object | object[];
}

const { title, description = t('site.description'), noindex = false, ogType = 'website', jsonLd } = Astro.props;
const fullTitle = title ? t('site.titleTemplate', { page: title }) : t('site.title');

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Sign in / sign out, only when people sign in (LESSONFOLK_AUTH=oauth).
const { authMode, user } = Astro.locals;
const navItems = [
  { href: '/', label: t('nav.home'), current: path === '/' },
  { href: '/courses', label: t('nav.courses'), current: path === '/courses' || path.startsWith('/courses/') },
  { href: '/authors', label: t('nav.authors'), current: path === '/authors' || path.startsWith('/authors/') },
  { href: '/connect', label: t('nav.connect'), current: path === '/connect' },
  // The learner's own data: only for someone whose data it is. With sign-in, the signed-in
  // name in the header links to it instead.
  ...(user && authMode !== 'oauth' ? [{ href: '/account', label: t('nav.account'), current: path === '/account' || path.startsWith('/account/') }] : []),
];
// Each nav link is a small bubble in its own tint.
const NAV_TINTS = ['sky', 'rose', 'teal', 'violet', 'indigo'];
const signInLink = signInHref(Astro.url);
// What a learner can say to their tutor at any time, ready to copy.
const sayPhrases = [t('home.continuePhrase'), t('home.reviewPhrase')];
const release = currentRelease();

// Search engines and link previews: canonical address (no query string or trailing slash),
// and no indexing of private pages or of "not found" pages.
const origin = siteOrigin(Astro.url);
const canonical = absoluteUrl(origin, path === '/' ? '/' : path);
const shareImage = absoluteUrl(origin, SHARE_IMAGE_PATH);
const hidden = noindex || Astro.response.status === 404;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content={hidden ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SHARE_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={SHARE_IMAGE_ALT} />
    <script is:inline src="/theme-init.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LessonFolk for AI assistants" />
    <title>{fullTitle}</title>
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="wordmark" href="/" aria-label={t('a11y.homeLink')}>
          <svg class="wordmark__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <rect class="wordmark__tile" width="64" height="64" rx="16"></rect>
            <path
              class="wordmark__letter"
              d="M22 14 L22 46 L42 46"
              fill="none"
              stroke-width="7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path class="wordmark__spark" d="M43 13Q44.6 22.4 54 24Q44.6 25.6 43 35Q41.4 25.6 32 24Q41.4 22.4 43 13Z"></path>
          </svg>
          <span class="wordmark__text">{t('site.name')}</span>
        </a>
        <div class="site-header__actions">
          <div class="site-menu" id="site-menu">
          <nav aria-label={t('a11y.mainNav')}>
            <ul class="nav-list" role="list">
              {
                navItems.map((item, i) => (
                  <li>
                    <a
                      class:list={['nav-link', `nav-link--${NAV_TINTS[i % NAV_TINTS.length]}`]}
                      href={item.href}
                      aria-current={item.current ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          {
            authMode === 'oauth' &&
              (user ? (
                <form class="account" method="post" action="/sign-out" aria-label={t('auth.accountLabel')}>
                  <a
                    class="account__name"
                    href="/account"
                    title={user.email}
                    aria-current={path === '/account' || path.startsWith('/account/') ? 'page' : undefined}
                  >
                    {user.name || user.email}
                  </a>
                  <button class="account__button" type="submit">
                    {t('auth.signOut')}
                  </button>
                </form>
              ) : (
                path !== '/sign-in' && (
                  <a class="account__button" href={signInLink}>
                    {t('auth.signIn')}
                  </a>
                )
              ))
          }
          </div>
          <ThemeToggle />
          <button
            class="menu-button"
            type="button"
            hidden
            aria-controls="site-menu"
            aria-expanded="false"
            data-menu-button
            data-label-open={t('a11y.menuOpen')}
            data-label-close={t('a11y.menuClose')}
          >
            <svg class="menu-button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path class="menu-button__bars" d="M4 7h16M4 12h16M4 17h16"></path>
              <path class="menu-button__cross" d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="container site-main" tabindex="-1">
      <slot />
    </main>

    {
      user && (
        <aside class="say-dock" aria-label={t('thread.sayLabel')}>
          <div class="container say-dock__inner">
            <p class="speaker">{t('thread.sayLabel')}</p>
            {sayPhrases.map((phrase) => (
              <span class="say-dock__item">
                <q class="say-dock__phrase" data-copy={phrase}>
                  {phrase}
                </q>
              </span>
            ))}
          </div>
        </aside>
      )
    }

    <footer class="container site-footer">
      <div class="card site-footer__bubble">
      <div class="site-footer__grid">
        <div class="site-footer__brand stack" style="--stack-space: var(--space-2)">
          <a class="wordmark" href="/" aria-label={t('a11y.homeLink')}>
            <span class="wordmark__text">{t('site.name')}</span>
          </a>
          <p>{t('footer.about')}</p>
        </div>
        <nav aria-label={t('footer.exploreHeading')}>
          <h2 class="site-footer__heading">{t('footer.exploreHeading')}</h2>
          <ul class="site-footer__links" role="list">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav aria-label={t('footer.projectHeading')}>
          <h2 class="site-footer__heading">{t('footer.projectHeading')}</h2>
          <ul class="site-footer__links" role="list">
            <li>
              <a href="https://github.com/CGSeb/lessonfolk" target="_blank" rel="noopener noreferrer">{t('footer.github')}</a>
            </li>
            <li><a href="/privacy">{t('footer.privacyLink')}</a></li>
          </ul>
        </nav>
      </div>
      <div class="site-footer__bottom">
        <p>{t('footer.copyright', { year: String(new Date().getFullYear()) })}</p>
        <p>{t('footer.license')}</p>
        {authMode !== 'oauth' && <p>{t('footer.privacy')}</p>}
        {
          release && (
            <p>
              <a class="site-footer__version" href={release.url} target="_blank" rel="noopener noreferrer">
                {t('footer.version', { version: release.version })}
              </a>
            </p>
          )
        }
      </div>
      </div>
    </footer>
    {user && <LiveRefresh />}
    <CopyButtons />
    <script>
      // Mobile menu: collapsed behind a button once JavaScript runs; without JavaScript the
      // links simply stay visible.
      const header = document.querySelector<HTMLElement>('.site-header');
      const button = header?.querySelector<HTMLButtonElement>('[data-menu-button]');
      if (header && button) {
        const narrow = window.matchMedia('(max-width: 47.99rem)');
        const set = (open: boolean) => {
          header.dataset.menu = open ? 'open' : 'closed';
          button.setAttribute('aria-expanded', String(open));
          const label = (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '';
          button.setAttribute('aria-label', label);
          button.title = label;
        };
        button.hidden = false;
        set(false);
        button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
        header.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
            set(false);
            button.focus();
          }
        });
        document.addEventListener('click', (event) => {
          if (event.target instanceof Node && !header.contains(event.target)) set(false);
        });
        narrow.addEventListener('change', () => set(false));
      }
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  .container {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    box-shadow: var(--shadow-raised);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-brand);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium); /* matches the logo files */
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-text);
  }

  .wordmark__mark {
    flex: none;
    width: 2.375rem;
    height: 2.375rem;
  }

  /* The logo colours are fixed brand values, the same in both themes. */
  .wordmark__tile {
    fill: var(--brand-indigo);
  }

  .wordmark__letter {
    stroke: var(--brand-white);
  }

  .wordmark__spark {
    fill: var(--brand-amber);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-menu {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .menu-button {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .menu-button[hidden] {
    display: none;
  }

  .menu-button:hover {
    color: var(--color-accent);
  }

  .menu-button__icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .menu-button[aria-expanded='true'] .menu-button__bars,
  .menu-button[aria-expanded='false'] .menu-button__cross {
    display: none;
  }

  /* Phones: logo and the two buttons on one row; links drop below in a full-width panel. */
  @media (max-width: 47.99rem) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .wordmark {
      margin-right: auto;
    }

    .site-header__actions {
      display: contents;
    }

    .site-menu {
      flex: 1 0 100%;
      order: 3;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding-top: var(--space-2);
    }

    .site-header[data-menu='closed'] .site-menu {
      display: none;
    }

    .nav-list {
      flex-direction: column;
      flex-wrap: nowrap;
    }

    .nav-link {
      display: block;
      padding-block: var(--space-3);
    }

    .account {
      justify-content: space-between;
      padding-top: var(--space-2);
    }
  }

  @media (min-width: 48rem) {
    .menu-button {
      display: none;
    }
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  /* Each link is a small tutor bubble in its own tint; the current page is the ink bubble. */
  .nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--bubble-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: 1.7;
    text-decoration: none;
  }

  .nav-link--sky {
    background: var(--color-tint-sky);
  }

  .nav-link--rose {
    background: var(--color-tint-rose);
  }

  .nav-link--teal {
    background: var(--color-tint-teal);
  }

  .nav-link--violet {
    background: var(--color-tint-violet);
  }

  .nav-link--indigo {
    background: var(--color-tint-indigo);
  }

  .nav-link:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .nav-link[aria-current='page'] {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .account {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .account__name {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--bubble-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: 1.7;
    text-decoration: none;
  }

  .account__name:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .account__name[aria-current='page'] {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  /* Signing in or out is the learner's own action: their bubble, tail bottom right. */
  .account__button {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 0;
    border-radius: var(--bubble-you-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: 1.7;
    text-decoration: none;
    cursor: pointer;
  }

  .account__button:hover {
    background: var(--color-accent-strong);
    color: var(--color-on-accent);
  }

  .site-main {
    flex: 1;
    padding-block: clamp(var(--space-5), 6vw, var(--space-7)) var(--space-8);
  }

  .site-main:focus {
    outline: none;
    box-shadow: none;
  }

  /* Phrases the learner can say to their tutor, each one a small "you" bubble to copy. */
  .say-dock {
    padding-block: var(--space-4);
    background: var(--color-surface);
  }

  .say-dock__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .say-dock__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-4);
    border-radius: var(--bubble-you-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .say-dock__phrase {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    quotes: none;
  }

  .site-footer {
    padding-block: var(--space-5) var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-6);
  }

  .site-footer__brand {
    max-width: 28rem;
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .site-footer__heading {
    margin-bottom: var(--space-2);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .site-footer__links {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .site-footer__links a,
  .site-footer__version {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-footer__links a:hover,
  .site-footer__version:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
  }
</style>
