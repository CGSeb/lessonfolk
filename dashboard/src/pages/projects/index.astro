---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogListing from '../../components/catalog/CatalogListing.astro';
import ProjectCard from '../../components/project/ProjectCard.astro';
import SignInPrompt from '../../components/SignInPrompt.astro';
import { courseAuthors } from '../../components/authors/authorView';
import { catalogListing } from '../../components/catalog/catalogFilter';
import { projectCard } from '../../components/project/projectView';
import { inspectCatalog, inspectProjects, progressOrEmpty } from '@lessonfolk/core';
import { loadProgressFor } from '../../lib/store';

const { t, lang } = Astro.locals;

// Read on every request so new projects and the tutor's latest writes show up. Public page:
// signed out (`progressResult` null), the projects are shown without progress.
const { catalog } = inspectCatalog(lang);
const { projects } = inspectProjects(lang);
const progressResult = await loadProgressFor(Astro.locals.user);
const showProgress = progressResult !== null;
const progress = progressOrEmpty(progressResult ?? { state: 'missing' });

// Same search, theme filter and paging as the course catalog, from the URL query.
const listing = catalogListing('/projects', projects, catalog.themes, Astro.url.searchParams);
---

<BaseLayout title={t('projects.title')} description={t('site.projectsDescription')}>
  <div class="stack" style="--stack-space: var(--space-5)">
    <header class="stack" style="--stack-space: var(--space-2)">
      <h1>{t('projects.heading')}</h1>
      <p class="muted">{t('projects.intro')}</p>
    </header>

    <SignInPrompt />

    {
      projects.length > 0 ? (
        <CatalogListing base="/projects" listing={listing} themes={catalog.themes}>
          {listing.shown.items.map((project) => {
            const view = projectCard(project, catalog, progress);
            return (
              <li>
                <ProjectCard view={view} authors={courseAuthors(project, catalog.authors)} showProgress={showProgress} />
              </li>
            );
          })}
        </CatalogListing>
      ) : (
        <div class="card stack" style="--stack-space: var(--space-3)">
          <p>{t('projects.empty')}</p>
          <p>
            <a class="button button--primary" href="/courses">{t('projects.browseCourses')}</a>
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
