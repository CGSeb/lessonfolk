---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLoopbackHost, verifyOAuthQueryParams } from '@lessonfolk/mcp';
import { t } from '../../i18n/en';
import { getAuth } from '../../lib/auth/auth';
import { getAuthSettings } from '../../lib/auth/current-user';

export const prerender = false;

/**
 * The consent page of the MCP authorization flow: a signed-in learner allows (or not) an AI
 * chat app to read and change their LessonFolk progress. Better Auth sends people here with
 * the signed authorization request in the query string.
 */
const settings = getAuthSettings();
if (settings.mode !== 'oauth') return Astro.redirect('/', 303);
const here = Astro.url.pathname + Astro.url.search;
if (!Astro.locals.user) return Astro.redirect(`/sign-in?next=${encodeURIComponent(here)}`, 303);

const oauthQuery = Astro.url.search.replace(/^\?/, '');
const params = new URLSearchParams(oauthQuery);
const valid = oauthQuery !== '' && (await verifyOAuthQueryParams(oauthQuery, settings.secret));

let clientName: string | undefined;
let redirectHost: string | undefined;
let redirectIsLocal = false;
if (valid) {
  try {
    const client = (await getAuth().api.getOAuthClientPublic({
      query: { client_id: params.get('client_id') ?? '' },
      headers: Astro.request.headers,
    })) as { client_name?: string };
    clientName = client.client_name;
  } catch {
    clientName = undefined;
  }
  try {
    const redirect = new URL(params.get('redirect_uri') ?? '');
    redirectHost = redirect.host;
    redirectIsLocal = redirect.protocol === 'http:' && isLoopbackHost(redirect.hostname);
  } catch {
    redirectHost = undefined;
  }
}
const appName = clientName || t('consent.unknownApp');
---

<BaseLayout title={t('consent.title')} noindex>
  <div class="stack consent" style="--stack-space: var(--space-5)">
    {
      valid ? (
        <>
          <header class="stack" style="--stack-space: var(--space-2)">
            <h1>{t('consent.heading', { app: appName })}</h1>
            <p class="muted">{t('consent.signedInAs', { name: Astro.locals.user.name })}</p>
            {clientName && <p class="muted">{t('consent.nameNotVerified', { app: clientName })}</p>}
            {redirectHost && (
              <div class:list={['consent__redirect', !redirectIsLocal && 'consent__redirect--warn']} role={redirectIsLocal ? undefined : 'alert'}>
                <p>
                  {t('consent.redirectLabel')} <strong class="consent__host">{redirectHost}</strong>
                </p>
                <p class="muted">{redirectIsLocal ? t('consent.redirectLocal') : t('consent.redirectWarning')}</p>
              </div>
            )}
            <p class="muted">{t('consent.onlyAllow')}</p>
          </header>
          <form method="post" action="/oauth/consent/decide" class="consent__actions">
            <input type="hidden" name="oauth_query" value={oauthQuery} />
            <button class="consent__button consent__button--primary" type="submit" name="accept" value="true">
              {t('consent.allow')}
            </button>
            <button class="consent__button" type="submit" name="accept" value="false">
              {t('consent.deny')}
            </button>
          </form>
        </>
      ) : (
        <header class="stack" style="--stack-space: var(--space-2)">
          <h1>{t('consent.expiredHeading')}</h1>
          <p class="muted">{t('consent.expiredBody')}</p>
        </header>
      )
    }
  </div>
</BaseLayout>

<style>
  .consent {
    max-width: 32rem;
  }

  .consent__redirect {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 0.5rem);
  }

  .consent__redirect--warn {
    border-color: var(--color-accent);
  }

  .consent__host {
    font-size: 1.15em;
    overflow-wrap: anywhere;
  }

  .consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .consent__button {
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .consent__button--primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .consent__button:hover {
    border-color: var(--color-accent);
  }
</style>
