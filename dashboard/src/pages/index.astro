---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/en';
import { getPaths } from '../lib/paths';

const paths = getPaths();
const hasProgress = existsSync(paths.progressFile);
---

<BaseLayout>
  <div class="stack">
    <h1>{t('home.heading')}</h1>
    <p>{t('home.placeholder')}</p>
    <ul>
      <li>{t('home.coursesPath')} <code>{paths.courses}</code></li>
      <li>
        {t('home.progressPath')} <code>{paths.progressFile}</code>
        ({hasProgress ? t('home.progressFound') : t('home.progressMissing')})
      </li>
    </ul>
  </div>
</BaseLayout>
