---
import { relative } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import NextLessonCard from '../components/NextLessonCard.astro';
import Notice from '../components/Notice.astro';
import OverallProgress from '../components/home/OverallProgress.astro';
import ProfileSummary from '../components/home/ProfileSummary.astro';
import SayPhrase from '../components/home/SayPhrase.astro';
import YourPath from '../components/home/YourPath.astro';
import { getHomeView } from '../components/home/homeView';
import { t } from '../i18n/en';
import { inspectCatalog } from '@lessonfolk/core';
import { getPaths } from '../lib/paths';
import Landing from '../components/home/Landing.astro';
import { loadProgress } from '../lib/store';
import { websiteJsonLd } from '../lib/seo';
import { siteOrigin } from '../lib/site-url';
import { offerLocalImport } from '../lib/account';
import LocalImportOffer from '../components/account/LocalImportOffer.astro';

// Home is the learner's own progress. Signed out (LESSONFOLK_AUTH=oauth), it is a landing page.
const { user } = Astro.locals;

// Read on every request so the page reflects the tutor's latest writes.
const { catalog, issues } = inspectCatalog('en');
const progressResult = user ? await loadProgress(user.id) : { state: 'missing' as const };
const { view, name, level, interests, path, suggestPath, lessons, progressError, progressWarnings } = getHomeView(
  catalog.courses,
  progressResult,
  catalog.themes,
);
// First run without sign-in: nothing in the database yet, but the tutor's progress file exists.
const offerImport = offerLocalImport(Astro.locals.authMode, progressResult.state);

const MAX_ISSUES = 5;
const { root } = getPaths();
const shownIssues = issues.slice(0, MAX_ISSUES).map(({ file, message }) => ({
  file: (relative(root, file) || file).replaceAll('\\', '/'),
  message,
}));
---

<BaseLayout jsonLd={user ? undefined : websiteJsonLd(siteOrigin(Astro.url), t('site.description'))}>
  {!user && <Landing />}
  {user && <div class="stack home" style="--stack-space: var(--space-6)">
    {offerImport && <LocalImportOffer />}
    {
      progressError && (
        <Notice tone="warning" title={t('home.invalidProgressTitle')}>
          <p>{t('home.invalidProgressBody')}</p>
          <details>
            <summary>{t('home.technicalDetails')}</summary>
            <pre class="home-error">{progressError}</pre>
          </details>
        </Notice>
      )
    }
    {
      progressWarnings.length > 0 && (
        <Notice tone="warning" title={t('home.progressWarningsTitle')}>
          <p>{t('home.progressWarningsBody')}</p>
          <details>
            <summary>{t('home.technicalDetails')}</summary>
            <ul class="home-issues">
              {progressWarnings.map((warning) => (
                <li>{warning}</li>
              ))}
            </ul>
          </details>
        </Notice>
      )
    }
    {
      issues.length > 0 && (
        <Notice tone="warning" title={t('home.courseIssuesTitle')}>
          <p>{t('home.courseIssuesBody')}</p>
          <pre><code>{t('home.courseIssuesCommand')}</code></pre>
          <ul class="home-issues">
            {shownIssues.map((issue) => (
              <li>
                <code>{issue.file}</code> {issue.message}
              </li>
            ))}
            {issues.length > MAX_ISSUES && <li>{t('home.courseIssuesMore', { count: issues.length - MAX_ISSUES })}</li>}
          </ul>
        </Notice>
      )
    }

    {
      view.state === 'new' ? (
        <>
          <header class="stack" style="--stack-space: var(--space-2)">
            <h1>{t('home.heading')}</h1>
            <p class="home-lead">{t('home.intro')}</p>
          </header>
          <div class="home-columns">
            <section class="card stack" aria-labelledby="start-heading">
              <h2 id="start-heading">{t('home.startTitle')}</h2>
              <ol class="home-steps">
                <li>
                  <span class="home-steps__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"></path></svg>
                  </span>
                  <p class="home-steps__text"><a href="/connect">{t('home.startStepOpen')}</a></p>
                </li>
                <li>
                  <span class="home-steps__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg>
                  </span>
                  <div class="home-steps__text">
                    <SayPhrase instruction={t('home.startStepSay')} phrase={t('home.startPhrase')} />
                  </div>
                </li>
                <li>
                  <span class="home-steps__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M5 21V4m0 0h11l-2 4 2 4H5"></path></svg>
                  </span>
                  <p class="home-steps__text">{t('home.startStepTutor')}</p>
                </li>
              </ol>
            </section>
            {view.first && (
              <NextLessonCard label={t('home.firstLesson')} course={view.first.course} lesson={view.first.lesson} />
            )}
          </div>
        </>
      ) : (
        <>
          <header class="stack" style="--stack-space: var(--space-3)">
            <div class="home-title">
              <h1>{name ? t('home.greeting', { name }) : t('home.greetingAnonymous')}</h1>
              <ProfileSummary level={level} interests={interests} />
            </div>
            <OverallProgress lessons={lessons} />
          </header>
          <div class="home-columns">
            <div class="stack" style="--stack-space: var(--space-5)">
              {view.state === 'in_progress' && (
                <NextLessonCard
                  label={view.next.kind === 'resume' ? t('home.resume') : t('home.nextUp')}
                  course={view.next.course}
                  lesson={view.next.lesson}
                >
                  <SayPhrase instruction={t('home.continueHint')} phrase={t('home.continuePhrase')} />
                </NextLessonCard>
              )}
              {view.state === 'done' && (
                <section class="card card--spark stack home-done" aria-labelledby="done-heading">
                  <h2 id="done-heading">{t('home.doneTitle')}</h2>
                  <p>{t('home.doneBody')}</p>
                  <SayPhrase instruction={t('home.doneReview')} phrase={t('home.reviewPhrase')} />
                </section>
              )}
              {view.state === 'blocked' && (
                <section class="card stack" aria-labelledby="blocked-heading">
                  <h2 id="blocked-heading">{t('home.blockedTitle')}</h2>
                  <SayPhrase instruction={t('home.blockedBody')} phrase={t('home.continuePhrase')} />
                </section>
              )}
              {view.state === 'empty' && (
                <section class="card stack" aria-labelledby="empty-heading">
                  <h2 id="empty-heading">{t('home.emptyTitle')}</h2>
                  <p>{t('home.emptyBody')}</p>
                </section>
              )}
              {path.state === 'set' && <YourPath courses={path.courses} reason={path.reason} updatedOn={path.updatedOn} />}
              {suggestPath && (
                <section class="card stack" aria-labelledby="no-path-heading">
                  <h2 id="no-path-heading">{t('path.noneTitle')}</h2>
                  <p>{t('path.noneBody')}</p>
                  <SayPhrase instruction={t('path.noneSay')} phrase={t('path.nonePhrase')} />
                </section>
              )}
            </div>
          </div>
        </>
      )
    }
  </div>}
</BaseLayout>

<style>
  .home-lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  /* One readable column: the next lesson first, the path below. */
  .home {
    max-width: 40rem;
    margin-inline: auto;
  }

  .home-columns {
    display: grid;
    gap: var(--space-5);
  }

  .home-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  /* Steps in order, each with a round indigo icon and small text. */
  .home-steps {
    display: grid;
    gap: var(--space-3);
    padding-left: 0;
    list-style: none;
  }

  .home-steps > li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: none;
  }

  .home-steps__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  .home-steps__icon svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .home-steps__text {
    flex: 1;
    min-width: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .home-done {
    padding-top: var(--space-6);
  }

  .home-issues {
    display: grid;
    gap: var(--space-1);
  }

  .home-error {
    margin-top: var(--space-2);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
