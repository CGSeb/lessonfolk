---
import BaseLayout from '../layouts/BaseLayout.astro';
import Notice from '../components/Notice.astro';
import SayPhrase from '../components/home/SayPhrase.astro';
import { connectClients } from '../components/connect/clients';
import { getAuthSettings } from '../lib/auth/current-user';
import { mcpConnection } from '../lib/connect';
import { t } from '../i18n/en';

export const prerender = false;

// Open to everyone: it only shows how to connect, never anyone's data.
const connection = mcpConnection(getAuthSettings(), Astro.url);
const clients = connectClients(connection);
// The first tool that works here opens by default.
const selected = clients.find((client) => client.available) ?? clients[0]!;
const host = new URL(connection.url).host;
---

<BaseLayout title={t('connect.title')}>
  <div class="stack" style="--stack-space: var(--space-6)">
    <header class="stack" style="--stack-space: var(--space-2)">
      <h1>{t('connect.heading')}</h1>
      <p class="connect-lead">{t('connect.intro')}</p>
    </header>

    <section class="card stack" aria-labelledby="url-heading" style="--stack-space: var(--space-3)">
      <h2 id="url-heading" class="connect-url__label">{t('connect.urlLabel')}</h2>
      <pre class="connect-url"><code data-mcp-url>{connection.url}</code></pre>
      <p class="muted">{t('connect.urlHint')}</p>
    </section>

    {
      connection.mode === 'none' ? (
        <>
          <Notice title={t('connect.localTitle')}>
            <p>{t('connect.localBody')}</p>
          </Notice>
          {connection.tokenRequired ? (
            <Notice title={t('connect.tokenTitle')}>
              <p>{t('connect.tokenBody')}</p>
            </Notice>
          ) : (
            <p class="muted">{t('connect.tokenOptional')}</p>
          )}
        </>
      ) : (
        <>
          <Notice title={t('connect.oauthTitle')}>
            <p>{t('connect.oauthBody')}</p>
          </Notice>
          {!connection.reachableFromWeb && (
            <Notice tone="warning" title={t('connect.webTitle')}>
              <p>{t('connect.webBody', { host })}</p>
            </Notice>
          )}
        </>
      )
    }

    <section class="stack" aria-labelledby="clients-heading" style="--stack-space: var(--space-4)">
      <h2 id="clients-heading">{t('connect.clientsHeading')}</h2>
      <div class="connect-tabs" data-connect-tabs>
        <div class="connect-tablist" role="tablist" aria-label={t('connect.clientsHeading')}>
          {
            clients.map((client) => (
              <a
                class="connect-tab"
                role="tab"
                id={`tab-${client.id}`}
                href={`#${client.id}`}
                aria-controls={client.id}
                aria-selected={client.id === selected.id ? 'true' : 'false'}
                tabindex={client.id === selected.id ? 0 : -1}
                data-client-tab={client.id}
              >
                {client.name}
              </a>
            ))
          }
        </div>
        {
          clients.map((client) => (
            <section
              class="card stack connect-client"
              role="tabpanel"
              id={client.id}
              data-client={client.id}
              aria-labelledby={`tab-${client.id}`}
              style="--stack-space: var(--space-3)"
            >
              <div class="cluster" style="--cluster-space: var(--space-2)">
                <h3 id={`client-${client.id}`}>{client.name}</h3>
                {!client.available && <span class="badge">{t('connect.notAvailable')}</span>}
              </div>
              <ol class="stack connect-steps" style="--stack-space: var(--space-3)">
                {client.steps.map((step) => (
                  <li class="stack" style="--stack-space: var(--space-2)">
                    <p>{step.text}</p>
                    {step.code && <pre><code>{step.code}</code></pre>}
                  </li>
                ))}
              </ol>
              {client.note && <p class="muted connect-note">{client.note}</p>}
            </section>
          ))
        }
      </div>
      <p class="muted">{t('connect.menusChange')}</p>
    </section>

    <section class="card stack" aria-labelledby="then-heading">
      <h2 id="then-heading">{t('connect.thenTitle')}</h2>
      <SayPhrase instruction={t('connect.thenSay')} phrase={t('connect.thenPhrase')} />
    </section>
  </div>
</BaseLayout>

<script>
  // Progressive enhancement: without JavaScript every panel stays visible and the tabs are
  // plain links to them. With it, one panel shows at a time; arrow keys move between tabs.
  const root = document.querySelector<HTMLElement>('[data-connect-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (tab: HTMLElement, focus = false) => {
      for (const other of tabs) {
        const on = other === tab;
        other.setAttribute('aria-selected', String(on));
        other.tabIndex = on ? 0 : -1;
      }
      for (const panel of panels) panel.hidden = panel.id !== tab.dataset.clientTab;
      if (focus) tab.focus();
    };
    const fromHash = () => tabs.find((tab) => `#${tab.dataset.clientTab}` === location.hash);
    root.classList.add('is-enhanced');
    select(fromHash() ?? tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') ?? tabs[0]!);
    for (const tab of tabs) {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        select(tab);
        history.replaceState(null, '', `#${tab.dataset.clientTab}`);
      });
      tab.addEventListener('keydown', (event) => {
        const i = tabs.indexOf(tab);
        const target =
          event.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length]
          : event.key === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length]
          : event.key === 'Home' ? tabs[0]
          : event.key === 'End' ? tabs[tabs.length - 1]
          : undefined;
        if (!target) return;
        event.preventDefault();
        select(target, true);
        history.replaceState(null, '', `#${target.dataset.clientTab}`);
      });
    }
    window.addEventListener('hashchange', () => {
      const tab = fromHash();
      if (tab) select(tab);
    });
  }
</script>

<style>
  .connect-tablist {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .connect-tab {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .connect-tab:hover {
    border-color: var(--color-accent-border);
    background: var(--color-accent-subtle);
  }

  .connect-tab[aria-selected='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
    color: var(--color-accent-strong);
  }

  /* Without JavaScript the panels are stacked under the tab links. */
  .connect-client[hidden] {
    display: none;
  }

  .connect-client + .connect-client {
    margin-top: var(--space-4);
  }

  .connect-lead {
    max-width: 70ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .connect-url__label {
    font-size: var(--text-xl);
  }

  .connect-url {
    font-size: var(--text-lg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .connect-steps {
    padding-left: var(--space-5);
  }

  .connect-steps pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .connect-note {
    font-size: var(--text-sm);
  }
</style>
