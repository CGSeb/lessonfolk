---
import BaseLayout from '../layouts/BaseLayout.astro';
import Notice from '../components/Notice.astro';
import { getAuthSettings } from '../lib/auth/current-user';
import { safeReturnPath } from '../lib/auth/redirect';
import { enabledProviders, type ProviderId } from '../lib/auth/settings';
import { t } from '../i18n/en';

export const prerender = false;

const settings = getAuthSettings();
const next = safeReturnPath(Astro.url.searchParams.get('next'));
// `?reauth=1`: already signed in, but asked to sign in again before exporting or deleting data.
const reauth = Astro.url.searchParams.get('reauth') === '1' && Astro.locals.user !== null;
// Nothing to sign in to without OAuth, and nothing to do when already signed in.
if (settings.mode !== 'oauth' || (Astro.locals.user && !reauth)) return Astro.redirect(next, 303);

const PROVIDER_NAMES: Record<ProviderId, string> = { github: 'GitHub', google: 'Google', fake: 'Test provider' };
const providers = enabledProviders(settings).map((id) => ({
  id,
  label: t('auth.signInWith', { provider: PROVIDER_NAMES[id] }),
}));
// Better Auth sends errors back here as ?error=<code>.
const error = Astro.url.searchParams.get('error');
---

<BaseLayout title={t('auth.signInTitle')}>
  <div class="stack sign-in" style="--stack-space: var(--space-5)">
    <header class="stack" style="--stack-space: var(--space-2)">
      <h1>{t(reauth ? 'auth.reauthHeading' : 'auth.signInHeading')}</h1>
      <p class="muted">{t(reauth ? 'auth.reauthIntro' : 'auth.signInIntro')}</p>
    </header>

    {
      error && (
        <Notice tone="warning" title={t('auth.signInError')}>
          <p class="muted">{t('auth.signInErrorDetails', { code: error })}</p>
        </Notice>
      )
    }

    <ul class="stack sign-in__providers" role="list" aria-label={t('auth.providersLabel')} style="--stack-space: var(--space-3)">
      {
        providers.map((provider) => (
          <li>
            <form method="post" action={`/sign-in/${provider.id}`}>
              <input type="hidden" name="next" value={next} />
              <button class="sign-in__button" type="submit" data-provider={provider.id}>
                {provider.id === 'github' && (
                  <svg class="sign-in__icon" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                  </svg>
                )}
                {provider.id === 'google' && (
                  <svg class="sign-in__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                  </svg>
                )}
                <span>{provider.label}</span>
              </button>
            </form>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .sign-in {
    max-width: 28rem;
    margin-inline: auto;
    text-align: center;
  }

  .sign-in :global(p) {
    margin-inline: auto;
  }

  .sign-in__providers {
    padding: 0;
    list-style: none;
  }

  .sign-in__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .sign-in__icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }

  .sign-in__button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
