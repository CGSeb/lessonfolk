---
import { t } from '../i18n/en';

interface Props {
  /** The course's theme; renders nothing when the theme is unknown. */
  theme: { id: string; title: string } | undefined;
}

const { theme } = Astro.props;
---

{
  theme && (
    <a
      class="badge theme-badge"
      href={`/courses#theme-${theme.id}`}
      title={t('theme.linkTitle', { theme: theme.title })}
    >
      <span class="visually-hidden">{t('theme.label')}:</span> {theme.title}
    </a>
  )
}

<style>
  .theme-badge {
    /* Above the course card's full-card link overlay, so the badge stays clickable. */
    position: relative;
    z-index: 1;
    border: 1px solid var(--color-theme-badge-border);
    background: var(--color-theme-badge-bg);
    color: var(--color-theme-badge-text);
    text-decoration: none;
  }

  .theme-badge:hover {
    border-color: var(--color-accent);
    text-decoration: underline;
  }
</style>
