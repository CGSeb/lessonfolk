---
import { t } from '../i18n/en';
import { coursesHref } from './catalog/catalogFilter';
import { themeToneClass } from './theme-tone';

interface Props {
  /** The course's theme; renders nothing when the theme is unknown. `position` picks its colour. */
  theme: { id: string; title: string; position?: number } | undefined;
}

const { theme } = Astro.props;
---

{
  theme && (
    <a
      class:list={['badge theme-badge', themeToneClass(theme.position)]}
      href={coursesHref({ theme: theme.id })}
      title={t('theme.linkTitle', { theme: theme.title })}
    >
      <span class="visually-hidden">{t('theme.label')}:</span> {theme.title}
    </a>
  )
}

<style>
  .theme-badge {
    /* Above the course card's full-card link overlay, so the badge stays clickable. */
    position: relative;
    z-index: 1;
    background: var(--color-theme-badge-bg);
    color: var(--color-theme-badge-text);
    text-decoration: none;
  }

  .theme-badge:hover {
    color: var(--color-theme-badge-text);
    text-decoration: underline;
  }
</style>
