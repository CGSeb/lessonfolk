---
import { t } from '../i18n/en';
import type { Course } from '../lib/courses';
import type { CourseStats } from '../lib/progress';
import CourseAuthors from './CourseAuthors.astro';
import LevelBadge from './LevelBadge.astro';
import ThemeBadge from './ThemeBadge.astro';
import type { AuthorLink } from './authors/authorView';
import { courseStatusDisplay, finishedLessons, getCourseStatus } from './course-status';

interface Props {
  /** One entry of `getStats(courses, progress).courses`. */
  stats: CourseStats<Course>;
  /** Heading level of the course title, to fit the page outline. */
  headingLevel?: 2 | 3;
  /** The course's theme, shown as a badge linking to the catalog filtered to it. */
  theme?: { id: string; title: string; position?: number };
  /** The course's authors, shown as a byline linking to their pages. */
  authors?: AuthorLink[];
  /** The course is in the learner's personal path: shows a "Recommended for you" marker. */
  recommended?: boolean;
}

const { stats, headingLevel = 2, theme, authors = [], recommended = false } = Astro.props;
const { course, total } = stats;
const finished = finishedLessons(stats);
const status = courseStatusDisplay(getCourseStatus(stats));
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const hours = course.estimatedHours;
const progressText = t('courses.lessonsProgress', { done: finished, total });
const hoursText = t(hours === 1 ? 'courses.hoursOne' : 'courses.hoursOther', { hours });
const lessonCountText = t(total === 1 ? 'courses.lessonCountOne' : 'courses.lessonCountOther', {
  count: total,
});
const progressId = `course-progress-${course.id}`;
---

<article class="card stack course-card" style="--stack-space: var(--space-3)">
  <Heading class="course-card__title">
    <a href={`/courses/${course.id}`}>{course.title}</a>
  </Heading>

  <CourseAuthors authors={authors} />

  <div class="cluster" style="--cluster-space: var(--space-2)">
    {
      recommended && (
        <span class="badge course-card__recommended" title={t('courses.recommendedTitle')}>
          {t('courses.recommended')}
        </span>
      )
    }
    <ThemeBadge theme={theme} />
    <LevelBadge level={course.level} />
    <span class:list={['badge', status.variant && `badge--${status.variant}`]}>
      <span class="visually-hidden">{t('status.label')}:</span> {t(status.key)}
    </span>
  </div>

  <p>{course.description}</p>

  <p class="muted course-card__meta">
    {hoursText} <span aria-hidden="true">·</span> {lessonCountText}
  </p>

  <div class="stack course-card__progress" style="--stack-space: var(--space-1)">
    <progress class="progress-bar" value={finished} max={Math.max(total, 1)} aria-labelledby={progressId}>
      {progressText}
    </progress>
    <p class="muted course-card__meta" id={progressId}>{progressText}</p>
  </div>
</article>

<style>
  .course-card {
    position: relative;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .course-card:hover {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-raised);
    transform: translateY(-2px);
  }

  .course-card__title {
    font-size: var(--text-xl);
  }

  .course-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .course-card__title a:hover {
    color: var(--color-accent);
  }

  /* The whole card is clickable through the title link. */
  .course-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .course-card__title a:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .course-card__title a:focus-visible::after {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
    box-shadow: 0 0 0 var(--focus-halo-width) var(--color-focus-halo);
  }

  .course-card__meta {
    font-size: var(--text-sm);
  }

  /* Spark dot + amber tint: the same cue as the next-lesson card, for courses in the learner's path. */
  .course-card__recommended {
    border: 1px solid var(--color-warning-border);
    background: var(--color-spark-subtle);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .course-card__recommended::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-spark);
  }

  .course-card__progress {
    margin-top: auto;
  }
</style>
