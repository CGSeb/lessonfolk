---
/**
 * Banner for something the learner should know about the page itself
 * (a problem with their files, a hint). Content goes in the default slot.
 */
interface Props {
  title: string;
  tone?: 'warning' | 'info';
  /** Thicker accent border on the left (default). Turn off for a plain, evenly bordered box. */
  accentBorder?: boolean;
}

const { title, tone = 'info', accentBorder = true } = Astro.props;
---

<aside class:list={['notice', `notice--${tone}`, { 'notice--plain': !accentBorder }]} aria-label={title}>
  <p class="notice__title">{title}</p>
  <div class="notice__body stack" style="--stack-space: var(--space-2)">
    <slot />
  </div>
</aside>

<style>
  .notice {
    padding: var(--space-4) var(--space-5);
    border: 1px solid;
    border-left-width: var(--border-accent);
    border-radius: var(--radius-md);
  }

  .notice--plain {
    border-left-width: 1px;
  }

  .notice--warning {
    border-color: var(--color-warning-border);
    background: var(--color-warning-bg);
    color: var(--color-warning);
  }

  .notice--info {
    border-color: var(--color-accent);
    background: var(--color-info-bg);
    color: var(--color-info);
  }

  .notice__title {
    font-weight: var(--weight-bold);
  }

  .notice__body {
    margin-top: var(--space-2);
    color: var(--color-text);
  }
</style>
