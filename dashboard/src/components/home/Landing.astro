---
/**
 * Landing page of the home route, for visitors who are not signed in (LESSONFOLK_AUTH=oauth).
 * Written as a chat: the visitor asks, the tutor answers. Explains what LessonFolk is and
 * invites people to sign in; the courses shown are public.
 */
import CourseCard from '../CourseCard.astro';
import { courseAuthors } from '../authors/authorView';
import { t } from '../../i18n/en';
import { getStats, inspectCatalog, progressOrEmpty } from '@lessonfolk/core';
import { signInHref } from '../../lib/auth/redirect';

const FEATURED_COURSES = 3;
const { catalog } = inspectCatalog('en');
const allStats = getStats(catalog.courses, progressOrEmpty({ state: 'missing' })).courses;
// Mix the levels: take the first course of each level in turn (beginner, intermediate, advanced),
// then the next of each, until there are enough; shown in catalog order.
const byLevel = ['beginner', 'intermediate', 'advanced'].map((level) => allStats.filter((s) => s.course.level === level));
const picked = new Set<(typeof allStats)[number]>();
for (let round = 0; picked.size < FEATURED_COURSES && byLevel.some((list) => round < list.length); round++) {
  for (const list of byLevel) if (round < list.length && picked.size < FEATURED_COURSES) picked.add(list[round]);
}
const stats = allStats.filter((s) => picked.has(s));
const themesById = new Map(catalog.themes.map((theme) => [theme.id, theme]));
const signIn = signInHref(Astro.url);

const steps = [
  { title: t('landing.step1Title'), body: t('landing.step1Body'), tint: 'sky' },
  { title: t('landing.step2Title'), body: t('landing.step2Body'), tint: 'rose' },
  { title: t('landing.step3Title'), body: t('landing.step3Body'), tint: 'teal' },
];
const reasons = [
  { title: t('landing.reason1Title'), body: t('landing.reason1Body'), tint: 'rose' },
  { title: t('landing.reason2Title'), body: t('landing.reason2Body'), tint: 'teal' },
  { title: t('landing.reason3Title'), body: t('landing.reason3Body'), tint: 'sky' },
];
---

<div class="stack landing" style="--stack-space: var(--space-5)">
  <div class="turn turn--you">
    <p class="speaker">{t('thread.you')}</p>
    <p class="bubble-you landing-ask">{t('landing.askStart')}</p>
  </div>

  <header class="turn">
    <p class="speaker">{t('thread.tutor')}</p>
    <div class="landing-hero">
      <div class="card card--indigo landing-hero__main stack" style="--stack-space: var(--space-5)">
        <p class="badge">{t('landing.overline')}</p>
        <h1 class="landing-hero__title">{t('landing.heading')}</h1>
        <p class="landing-lead">{t('landing.lead')}</p>
        <p class="landing-actions">
          <a class="button button--primary" href={signIn}>{t('landing.ctaStart')}</a>
          <a class="button landing-actions__secondary" href="/courses">{t('landing.ctaCourses')}</a>
        </p>
      </div>
      <div class="landing-hero__patches" aria-hidden="true">
        <span class="landing-patch landing-patch--spark"></span>
        <span class="landing-patch landing-patch--rose"></span>
        <span class="landing-patch landing-patch--teal"></span>
      </div>
    </div>
  </header>

  <section class="stack" aria-labelledby="how-heading" style="--stack-space: var(--space-5)">
    <div class="turn turn--you">
      <p class="speaker">{t('thread.you')}</p>
      <p class="bubble-you landing-ask">{t('landing.askHow')}</p>
    </div>
    <div class="turn">
      <p class="speaker">{t('thread.tutor')}</p>
      <h2 class="overline" id="how-heading">{t('landing.howTitle')}</h2>
      <ol class="landing-steps" role="list">
        {
          steps.map((step, i) => (
            <li class:list={['card', `card--${step.tint}`, 'landing-step']}>
              <span class="landing-step__number" aria-hidden="true">
                {i + 1}
              </span>
              <div class="stack" style="--stack-space: var(--space-1)">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    stats.length > 0 && (
      <section class="stack" aria-labelledby="courses-heading" style="--stack-space: var(--space-5)">
        <div class="turn turn--you">
          <p class="speaker">{t('thread.you')}</p>
          <p class="bubble-you landing-ask">{t('landing.askWhat')}</p>
        </div>
        <div class="turn">
          <p class="speaker">{t('thread.tutor')}</p>
          <div class="card stack" style="--stack-space: var(--space-1)">
            <h2 class="overline" id="courses-heading">
              {t('landing.coursesTitle')}
            </h2>
            <p class="landing-say">{t('landing.coursesIntro')}</p>
          </div>
          <ul class="grid landing-courses" role="list" style="--grid-min: 18rem">
            {stats.map((courseStats) => (
              <li>
                <CourseCard
                  stats={courseStats}
                  headingLevel={3}
                  theme={themesById.get(courseStats.course.theme)}
                  authors={courseAuthors(courseStats.course, catalog.authors)}
                  showProgress={false}
                />
              </li>
            ))}
          </ul>
          <p>
            <a href="/courses">{t('landing.coursesAll', { count: catalog.courses.length })}</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="stack" aria-labelledby="why-heading" style="--stack-space: var(--space-5)">
    <div class="turn turn--you">
      <p class="speaker">{t('thread.you')}</p>
      <p class="bubble-you landing-ask">{t('landing.askWhy')}</p>
    </div>
    <div class="turn">
      <p class="speaker">{t('thread.tutor')}</p>
      <h2 class="overline" id="why-heading">{t('landing.whyTitle')}</h2>
      <ul class="landing-reasons" role="list">
        {
          reasons.map((reason) => (
            <li class:list={['card', `card--${reason.tint}`, 'stack']} style="--stack-space: var(--space-1)">
              <h3>{reason.title}</h3>
              <p>{reason.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="card card--spark stack landing-final" aria-labelledby="final-heading" style="--stack-space: var(--space-3)">
    <h2 id="final-heading">{t('landing.finalTitle')}</h2>
    <p class="landing-final__body">{t('landing.finalBody')}</p>
    <p><a class="button landing-final__button" href={signIn}>{t('landing.ctaStart')}</a></p>
  </section>
</div>

<style>
  .landing-ask {
    max-width: 32rem;
    font-size: var(--text-xl);
  }

  /* The headline bubble, with three colour patches beside it (below it on a phone). */
  .landing-hero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    width: 100%;
  }

  .landing-hero__main {
    flex: 999 1 30rem;
    min-width: 0;
    align-items: flex-start;
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    border-radius: var(--bubble-xl);
  }

  .landing-hero__title {
    font-size: var(--text-hero);
    line-height: 0.96;
  }

  .landing-hero__patches {
    display: flex;
    flex: 1 1 11rem;
    flex-direction: column;
    gap: var(--space-3);
  }

  .landing-patch {
    flex: 1 1 5rem;
    min-height: 5rem;
    border-radius: var(--bubble-xl);
  }

  .landing-patch--spark {
    background: var(--color-spark);
  }

  .landing-patch--rose {
    border-radius: var(--radius-xl) var(--radius-xl) 10px var(--radius-xl);
    background: light-dark(var(--rose-300), var(--rose-700));
  }

  .landing-patch--teal {
    background: light-dark(var(--teal-300), var(--teal-700));
  }

  @media (max-width: 47.99rem) {
    .landing-hero__patches {
      flex-direction: row;
    }
  }

  .landing-lead {
    max-width: 36rem;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .landing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* On the tinted hero bubble the second button is white, not grey. */
  .landing-actions__secondary {
    background: var(--color-surface-sunken);
  }

  .landing-steps,
  .landing-reasons {
    display: grid;
    gap: var(--space-3);
    width: 100%;
    padding-left: 0;
    list-style: none;
  }

  .landing-steps > li,
  .landing-reasons > li,
  .landing-courses > li {
    max-width: none;
  }

  /* Each step is a bubble a little further right than the one before, like a staircase. */
  .landing-steps > .landing-step {
    display: flex;
    gap: var(--space-5);
    max-width: 46rem;
  }

  .landing-steps > .landing-step:nth-child(2) {
    margin-left: clamp(0px, 4vw, 3rem);
  }

  .landing-steps > .landing-step:nth-child(3) {
    margin-left: clamp(0px, 8vw, 6rem);
  }

  .landing-step__number {
    flex: none;
    width: 2.75rem;
    font-size: 4rem;
    font-weight: var(--weight-extrabold);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .landing-reasons {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .landing-say {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
  }

  .landing-courses {
    width: 100%;
    padding-left: 0;
    gap: var(--space-3);
    list-style: none;
  }

  .landing-courses > li {
    display: flex;
  }

  .landing-courses > li > :global(*) {
    flex: 1;
  }

  .landing-final {
    align-items: flex-start;
    margin-top: var(--space-4);
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    border-radius: var(--bubble-xl);
  }

  .landing-final h2 {
    font-size: var(--text-3xl);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .landing-final__body {
    font-size: var(--text-lg);
  }

  /* On amber the action is the ink bubble: indigo on amber would clash. */
  .landing-final__button,
  .landing-final__button:hover {
    border-color: transparent;
    border-radius: var(--bubble-you-md);
    background: var(--color-on-spark);
    color: var(--neutral-0);
  }
</style>
