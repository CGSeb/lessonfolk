---
import { t } from '../../i18n/en';
import type { Course } from '@lessonfolk/core';
import type { PathCourse } from './pathView';
import PathRows from './PathRows.astro';

/**
 * The learner's personal path. Shows the current course and the next ones (finished courses
 * before it and courses after the window fold away), and the tutor's reason on demand.
 */
interface Props {
  courses: PathCourse<Course>[];
  reason: string | undefined;
  updatedOn: string | undefined;
}

const VISIBLE = 3;
const { courses, reason, updatedOn } = Astro.props;

// The window starts at the first course that is not finished.
const open = courses.findIndex((row) => row.status !== 'done' && row.status !== 'skipped_placement');
const start = open === -1 ? Math.max(courses.length - VISIBLE, 0) : open;
const before = courses.slice(0, start);
const shown = courses.slice(start, start + VISIBLE);
const after = courses.slice(start + VISIBLE);
---

<section class="card stack" aria-labelledby="your-path-heading" style="--stack-space: var(--space-3)">
  <h2 id="your-path-heading">{t('path.title')}</h2>

  {
    before.length > 0 && (
      <details>
        <summary>{t('path.earlier', { count: before.length })}</summary>
        <PathRows courses={before} startAt={1} />
      </details>
    )
  }
  <PathRows courses={shown} startAt={start + 1} />
  {
    after.length > 0 && (
      <details>
        <summary>{t('path.more', { count: after.length })}</summary>
        <PathRows courses={after} startAt={start + shown.length + 1} />
      </details>
    )
  }
  {
    (reason || updatedOn) && (
      <details>
        <summary>{t('path.reasonLabel')}</summary>
        <div class="your-path__reason stack" style="--stack-space: var(--space-1)">
          {reason && <p>{reason}</p>}
          {updatedOn && <p class="muted your-path__updated">{t('path.updatedOn', { date: updatedOn })}</p>}
        </div>
      </details>
    )
  }
</section>

<style>
  summary {
    cursor: pointer;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  details > :global(ol) {
    margin-top: var(--space-2);
  }

  /* The tutor's own words: a soft panel with an accent rule, like a quoted chat message. */
  .your-path__reason {
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-md);
    background: var(--color-accent-subtle);
  }

  .your-path__updated {
    font-size: var(--text-sm);
  }
</style>
