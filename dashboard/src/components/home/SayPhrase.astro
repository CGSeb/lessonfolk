---
/** An instruction followed by the exact message to send to the tutor. */
interface Props {
  instruction: string;
  phrase: string;
}

const { instruction, phrase } = Astro.props;
---

<p class="say">
  <span>{instruction}</span>
  <q class="say__phrase">{phrase}</q>
</p>

<style>
  .say {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  /* Phrase chip: what to type to the tutor. Looks like a friendly chat bubble, not code. */
  .say__phrase {
    padding: 0.2em 0.85em;
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-pill);
    background: var(--color-accent-subtle);
    color: var(--color-accent-strong);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }
</style>
