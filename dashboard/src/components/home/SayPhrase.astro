---
/** An instruction followed by the exact message to send to the tutor. */
interface Props {
  instruction: string;
  phrase: string;
}

const { instruction, phrase } = Astro.props;
---

<p class="say">
  <span>{instruction}</span>
  <q class="say__phrase">{phrase}</q>
</p>

<style>
  .say {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .say__phrase {
    padding: 0.1em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-sunken);
    font-family: var(--font-mono);
    font-size: 0.95em;
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
</style>
