---
/** An instruction followed by the exact message to send to the tutor. */
interface Props {
  instruction: string;
  phrase: string;
}

const { instruction, phrase } = Astro.props;
---

<p class="say">
  <span>{instruction}</span>
  <span class="say__bubble">
    <q class="say__phrase" data-copy={phrase}>{phrase}</q>
  </span>
</p>

<style>
  .say {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  /* What to type to the tutor: the learner's own bubble (indigo, tail bottom right), with its Copy button. */
  .say__bubble {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-4);
    border-radius: var(--bubble-you-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .say__phrase {
    padding-block: var(--space-1);
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    quotes: none;
  }
</style>
