---
import { t } from '../../i18n/en';

/** Overall progress in one line: lessons finished, with a bar. */
interface Props {
  lessons: { finished: number; total: number };
}

const { lessons } = Astro.props;
const lessonsText = t('home.progressLessons', lessons);
---

<div class="stack" style="--stack-space: var(--space-2)">
  <p class="overall-progress__lessons">{lessonsText}</p>
  <progress class="progress-bar" value={lessons.finished} max={Math.max(lessons.total, 1)} aria-label={t('home.progressTitle')}>
    {lessonsText}
  </progress>
</div>

<style>
  .overall-progress__lessons {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
