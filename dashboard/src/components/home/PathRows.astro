---
import { t } from '../../i18n/en';
import type { Course } from '@lessonfolk/core';
import type { PathCourse } from './pathView';
import { pathStatusDisplay } from './pathView';

/** Rows of the learner's path. `startAt` is the position of the first row in the whole path. */
interface Props {
  courses: PathCourse<Course>[];
  startAt: number;
}

const { courses, startAt } = Astro.props;
const rows = courses.map((row) => ({
  ...row,
  display: pathStatusDisplay(row.status),
  lessonsText: t('path.lessons', { finished: row.finished, total: row.total }),
  placementText:
    row.placementSkipped > 0 && row.status !== 'skipped_placement'
      ? t(row.placementSkipped === 1 ? 'path.placementOne' : 'path.placementOther', { count: row.placementSkipped })
      : undefined,
}));
---

<ol class="path-rows" role="list" aria-label={t('path.listLabel')} style={`counter-reset: path-step ${startAt - 1}`}>
  {
    rows.map((row) => (
      <li
        class:list={['path-rows__item', `path-rows__item--${row.status}`, row.isNext && 'path-rows__item--next']}
        aria-current={row.isNext ? 'step' : undefined}
      >
        <div class="path-rows__body stack" style="--stack-space: var(--space-1)">
          <h3 class="path-rows__course">
            <a href={`/courses/${encodeURIComponent(row.course.id)}`}>{row.course.title}</a>
          </h3>
          <p class="muted path-rows__meta">
            {row.lessonsText}
            {row.placementText && (
              <>
                <span aria-hidden="true"> · </span>
                <span>{row.placementText}</span>
              </>
            )}
          </p>
        </div>
        <span class:list={['badge', row.display.variant && `badge--${row.display.variant}`]}>
          <span class="visually-hidden">{t('status.label')}:</span> {t(row.display.key)}
        </span>
      </li>
    ))
  }
</ol>

<style>
  .path-rows {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  /* One bubble per course: step number, title and lessons, status badge. */
  .path-rows__item {
    --badge-bg: var(--color-surface-sunken);
    display: flex;
    flex: 1 1 14rem;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: none;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--bubble-lg);
    background: var(--color-surface);
    counter-increment: path-step;
  }

  .path-rows__item::before {
    content: counter(path-step);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  /* Finished courses turn green; the course the next lesson comes from is the spark bubble. */
  .path-rows__item--done,
  .path-rows__item--skipped_placement {
    background: var(--color-success-bg);
  }

  .path-rows__item--next > * {
    color-scheme: light;
  }

  .path-rows__item--next {
    --color-text-muted: var(--color-on-spark-muted);
    --color-accent: var(--color-on-spark);
    --color-accent-strong: var(--color-on-spark);
    --color-accent-border: var(--color-on-spark);
    --color-focus: var(--color-on-spark);
    background: var(--color-spark);
    color: var(--color-on-spark);
  }

  .path-rows__body {
    flex: 1;
    min-width: 0;
  }

  .path-rows__course {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .path-rows__course a {
    color: var(--color-text);
    font-weight: inherit;
    text-decoration: none;
  }

  .path-rows__course a:hover {
    text-decoration: underline;
  }

  .path-rows__meta {
    font-size: var(--text-sm);
  }
</style>
