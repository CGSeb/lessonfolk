---
import { t } from '../../i18n/en';
import DoneCheck from '../DoneCheck.astro';
import type { ThemeProgress } from './homeView';

/** Progress per theme: one row per non-empty theme, linking to the catalog filtered to it. */
interface Props {
  themes: ThemeProgress[];
}

const { themes } = Astro.props;
---

<section class="card stack" aria-labelledby="theme-progress-heading" style="--stack-space: var(--space-4)">
  <h2 class="theme-progress__heading" id="theme-progress-heading">{t('theme.progressTitle')}</h2>
  <ul class="stack theme-progress__list" role="list" style="--stack-space: var(--space-3)">
    {
      themes.map(({ id, title, href, finished, total, completed }) => {
        const labelId = `theme-progress-${id}`;
        const text = t('theme.progressLessons', { finished, total });
        return (
          <li class="stack" style="--stack-space: var(--space-1)">
            <p class="theme-progress__row" id={labelId}>
              <span class="theme-progress__name">
                <a href={href}>{title}</a>
                {completed && <DoneCheck />}
              </span>
              <span class="muted">{text}</span>
            </p>
            <progress class="progress-bar" value={finished} max={Math.max(total, 1)} aria-labelledby={labelId}>
              {text}
            </progress>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .theme-progress__heading {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .theme-progress__list {
    padding: 0;
    list-style: none;
  }

  .theme-progress__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
  }

  .theme-progress__name {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }

  .theme-progress__row a {
    font-weight: var(--weight-medium);
  }
</style>
