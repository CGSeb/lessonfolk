---
import { t } from '../../i18n/en';
import type { ThemeProgress } from './homeView';

/** Progress per theme: one row per non-empty theme, linking to its catalog section. */
interface Props {
  themes: ThemeProgress[];
}

const { themes } = Astro.props;
---

<section class="card stack" aria-labelledby="theme-progress-heading" style="--stack-space: var(--space-4)">
  <h2 class="theme-progress__heading" id="theme-progress-heading">{t('theme.progressTitle')}</h2>
  <ul class="stack theme-progress__list" role="list" style="--stack-space: var(--space-3)">
    {
      themes.map(({ id, title, anchor, finished, total, completed }) => {
        const labelId = `theme-progress-${id}`;
        const text = t('theme.progressLessons', { finished, total });
        return (
          <li class="stack" style="--stack-space: var(--space-1)">
            <p class="theme-progress__row" id={labelId}>
              <span class="theme-progress__name">
                <a href={`/courses#${anchor}`}>{title}</a>
                {completed && (
                  <span class="theme-progress__done">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M5 12.5l4.5 4.5L19 7.5"></path>
                    </svg>
                    <span class="visually-hidden">{t('status.label')}: {t('status.completed')}</span>
                  </span>
                )}
              </span>
              <span class="muted">{text}</span>
            </p>
            <progress class="progress-bar" value={finished} max={Math.max(total, 1)} aria-labelledby={labelId}>
              {text}
            </progress>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .theme-progress__heading {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .theme-progress__list {
    padding: 0;
    list-style: none;
  }

  .theme-progress__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
  }

  .theme-progress__name {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }

  /* Small check in a success circle; the status is spelled out for screen readers. */
  .theme-progress__done {
    display: inline-grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: var(--radius-pill);
    background: var(--color-success-bg);
    color: var(--color-success);
  }

  .theme-progress__done svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-progress__row a {
    font-weight: var(--weight-medium);
  }
</style>
