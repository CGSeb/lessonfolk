---
/**
 * Invitation to sign in, on public pages seen signed out (LESSONFOLK_AUTH=oauth).
 * Renders nothing when signed in or without sign-in.
 */
import Notice from './Notice.astro';
import { signInHref } from '../lib/auth/redirect';
import { t } from '../i18n/en';

const { authMode, user } = Astro.locals;
const show = authMode === 'oauth' && !user;
---

{
  show && (
    <Notice title={t('auth.promptTitle')}>
      <p>{t('auth.promptBody')}</p>
      <p>
        <a class="sign-in-prompt__link" href={signInHref(Astro.url)}>
          {t('auth.signIn')}
        </a>
      </p>
    </Notice>
  )
}

<style>
  .sign-in-prompt__link {
    font-weight: var(--weight-semibold);
  }
</style>
