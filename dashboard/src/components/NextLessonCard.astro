---
import type { Course, Lesson } from '@lessonfolk/core';
import { t } from '../i18n/en';

/**
 * The lesson the tutor will teach next, in the spark bubble: title, linked course and
 * duration, with the objectives on demand. Put how to start it (an instruction, a SayPhrase)
 * in the default slot.
 */
interface Props {
  /** Card heading, e.g. "Next up". */
  label: string;
  course: Pick<Course, 'id' | 'title'>;
  lesson: Pick<Lesson, 'title' | 'estimatedMinutes' | 'objectives'>;
}

const { label, course, lesson } = Astro.props;
const headingId = 'next-lesson-heading';
---

<section class="card card--spark next-lesson stack" aria-labelledby={headingId} style="--stack-space: var(--space-3)">
  <h2 class="badge next-lesson__label" id={headingId}>{label}</h2>
  <div class="stack" style="--stack-space: var(--space-2)">
    <h3 class="next-lesson__title">{lesson.title}</h3>
    <p class="cluster" style="--cluster-space: var(--space-2)">
      <a href={`/courses/${encodeURIComponent(course.id)}`}>{course.title}</a>
      <span class="badge">{t('home.minutes', { minutes: lesson.estimatedMinutes })}</span>
    </p>
  </div>
  <slot />
  <details>
    <summary>{t('home.objectives')}</summary>
    <ul class="next-lesson__objectives">
      {lesson.objectives.map((objective) => <li>{objective}</li>)}
    </ul>
  </details>
</section>

<style>
  .next-lesson {
    align-items: flex-start;
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border-radius: var(--bubble-xl);
  }

  /* The label is the ink bubble on amber. */
  .next-lesson__label {
    background: var(--color-on-spark);
    color: var(--neutral-0);
    letter-spacing: normal;
  }

  .next-lesson__title {
    font-size: var(--text-3xl);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .next-lesson summary {
    cursor: pointer;
    font-size: var(--text-sm);
  }

  .next-lesson__objectives {
    display: grid;
    margin-top: var(--space-2);
    gap: var(--space-2);
    padding-left: 0;
    list-style: none;
  }

  /* Round bullets that echo the spark dot. */
  .next-lesson__objectives li {
    position: relative;
    padding-left: var(--space-5);
  }

  .next-lesson__objectives li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0.15rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-on-spark);
  }
</style>
