---
import type { Course, Lesson } from '@lessonfolk/core';
import { t } from '../i18n/en';

/**
 * The lesson the tutor will teach next: course, title, duration and objectives,
 * with a link to the course. Put how to start it (e.g. a SayPhrase) in the default slot.
 */
interface Props {
  /** Card heading, e.g. "Next up". */
  label: string;
  course: Pick<Course, 'id' | 'title'>;
  lesson: Pick<Lesson, 'title' | 'estimatedMinutes' | 'objectives'>;
}

const { label, course, lesson } = Astro.props;
const headingId = 'next-lesson-heading';
---

<section class="card card--spark next-lesson stack" aria-labelledby={headingId}>
  <h2 class="overline" id={headingId}>{label}</h2>
  <div class="stack" style="--stack-space: var(--space-1)">
    <h3>{lesson.title}</h3>
    <p class="cluster muted" style="--cluster-space: var(--space-2)">
      <span>{t('home.inCourse', { course: course.title })}</span>
      <span class="badge">{t('home.minutes', { minutes: lesson.estimatedMinutes })}</span>
    </p>
  </div>
  <div class="stack" style="--stack-space: var(--space-2)">
    <h4>{t('home.objectives')}</h4>
    <ul class="next-lesson__objectives">
      {lesson.objectives.map((objective) => <li>{objective}</li>)}
    </ul>
  </div>
  <slot />
  <p>
    <a href={`/courses/${encodeURIComponent(course.id)}`}>{t('home.viewCourse', { course: course.title })}</a>
  </p>
</section>

<style>
  .next-lesson h4 {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .next-lesson__objectives {
    display: grid;
    gap: var(--space-2);
    padding-left: 0;
    list-style: none;
  }

  /* Rounded tick-like bullets that echo the mark's rounded strokes. */
  .next-lesson__objectives li {
    position: relative;
    padding-left: var(--space-5);
  }

  .next-lesson__objectives li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0.15rem;
    width: 0.5rem;
    height: 0.5rem;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-pill);
  }
</style>
