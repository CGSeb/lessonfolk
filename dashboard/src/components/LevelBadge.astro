---
import { t } from '../i18n/en';
import type { Level } from '../lib/courses';

interface Props {
  level: Level;
}

const { level } = Astro.props;
---

<span class="badge level-badge">
  <span class="visually-hidden">{t('level.label')}:</span> {t(`level.${level}`)}
</span>

<style>
  .level-badge {
    border: 1px solid var(--color-border);
    background: transparent;
  }
</style>
