---
import { catalogHref, OTHER_THEME, type CatalogBase, type CatalogListing } from './catalogFilter';
import { themeToneClass } from '../theme-tone';

const { t } = Astro.locals;

/**
 * The listing of a catalog page (courses or projects): the search, the theme filter badges, the
 * result count, the cards (the default slot: one `<li>` per item shown) and the pager. The search
 * updates the results in place as the learner types; without JavaScript it is a plain GET form.
 */
interface Props {
  /** The page it lists: its URL, and the prefix of its texts (`courses.*` or `projects.*`). */
  base: CatalogBase;
  listing: CatalogListing<unknown>;
  /** The themes, for the badge titles and colours. */
  themes: { id: string; title: string; position: number }[];
  /** The "Recommended for you" checkbox next to the search; left out, there is none. */
  recommendedFilter?: { count: number; current: boolean };
}

const { base, listing, themes, recommendedFilter } = Astro.props;
const prefix = base === '/courses' ? 'courses' : 'projects';
const { query, shown, pages } = listing;
const themesById = new Map(themes.map((theme) => [theme.id, theme]));
const themeTitle = (id: string | undefined) =>
  id === OTHER_THEME ? t(`${prefix}.otherThemeTitle`) : (themesById.get(id ?? '')?.title ?? t('courses.allThemes'));
const badges = listing.badges.map(({ id, count, href, current }) => ({
  title: themeTitle(id),
  count,
  tone: id === undefined ? 'theme-filter--all' : themeToneClass(themesById.get(id)?.position),
  href,
  current,
}));
const resultsText =
  shown.total === 0
    ? query.theme
      ? t(`${prefix}.noResultsInTheme`, { theme: themeTitle(query.theme) })
      : t(`${prefix}.noResults`)
    : shown.pageCount > 1
      ? t(`${prefix}.resultsRange`, { from: shown.from, to: shown.to, total: shown.total })
      : t(shown.total === 1 ? `${prefix}.resultsOne` : `${prefix}.resultsOther`, { total: shown.total });
---

<div class="stack" style="--stack-space: var(--space-5)">
  <form class="catalog-search" role="search" method="get" action={base} data-catalog-search>
    <label class="visually-hidden" for="catalog-search-input">
      {t(`${prefix}.searchLabel`)}
    </label>
    {query.theme && <input type="hidden" name="theme" value={query.theme} />}
    <div class="catalog-search__field">
      <input
        class="catalog-search__input"
        id="catalog-search-input"
        type="search"
        name="q"
        value={query.q}
        placeholder={t(`${prefix}.searchPlaceholder`)}
        autocomplete="off"
        maxlength="100"
      />
      <button class="catalog-search__button" type="submit">
        {t('courses.searchButton')}
      </button>
    </div>
    {
      recommendedFilter && (
        <label class="catalog-search__recommended">
          <input type="checkbox" name="recommended" value="1" checked={recommendedFilter.current} />
          {t('courses.recommended')}
          <span class="muted">({recommendedFilter.count})</span>
        </label>
      )
    }
  </form>

  {/* Announces the result count when the search updates in place. */}
  <p class="visually-hidden" role="status" data-catalog-status></p>

  {/* Swapped in place as the learner types (see the script below). */}
  <div class="stack" style="--stack-space: var(--space-5)" data-catalog-results>
    <nav aria-label={t('courses.themeFilterLabel')}>
      <ul class="cluster theme-filters" role="list" style="--cluster-space: var(--space-2)">
        {
          badges.map(({ title, count, tone, href, current }) => (
            <li>
              <a class:list={['theme-filter', tone]} href={href} aria-current={current ? 'true' : undefined}>
                {title}
                <span class="theme-filter__count">
                  <span aria-hidden="true">{count}</span>
                  <span class="visually-hidden">
                    ({t(count === 1 ? `${prefix}.themeCountOne` : `${prefix}.themeCountOther`, { count })})
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="stack" style="--stack-space: var(--space-3)">
      <p class="muted" data-catalog-count>
        {resultsText}
      </p>
      {
        shown.total === 0 && (
          <p class="cluster" style="--cluster-space: var(--space-4)">
            {query.q && <a href={catalogHref(base, { theme: query.theme, recommended: query.recommended })}>{t('courses.clearSearch')}</a>}
            {query.theme && <a href={catalogHref(base, { recommended: query.recommended })}>{t(`${prefix}.showAll`)}</a>}
          </p>
        )
      }
    </div>

    {
      shown.items.length > 0 && (
        <ol class="grid catalog-list" role="list" aria-label={t(`${prefix}.listLabel`)}>
          <slot />
        </ol>
      )
    }

    {
      shown.pageCount > 1 && (
        <nav class="pager" aria-label={t('courses.pagerLabel')}>
          <ul class="cluster" role="list" style="--cluster-space: var(--space-2)">
            <li>
              {shown.page > 1 ? (
                <a class="pager__link" href={catalogHref(base, { ...query, page: shown.page - 1 })} rel="prev">
                  {t('courses.previousPage')}
                </a>
              ) : (
                <span class="pager__link" aria-disabled="true">
                  {t('courses.previousPage')}
                </span>
              )}
            </li>
            {pages.map((item) =>
              item ? (
                <li>
                  <a
                    class="pager__link"
                    href={item.href}
                    aria-current={item.current ? 'page' : undefined}
                    aria-label={t('courses.pageLabel', { page: item.page })}
                  >
                    {item.page}
                  </a>
                </li>
              ) : (
                <li class="pager__gap" aria-hidden="true">
                  …
                </li>
              ),
            )}
            <li>
              {shown.page < shown.pageCount ? (
                <a class="pager__link" href={catalogHref(base, { ...query, page: shown.page + 1 })} rel="next">
                  {t('courses.nextPage')}
                </a>
              ) : (
                <span class="pager__link" aria-disabled="true">
                  {t('courses.nextPage')}
                </span>
              )}
            </li>
          </ul>
        </nav>
      )
    }
  </div>
</div>

<script>
  import { catalogHref, type CatalogBase } from './catalogFilter';

  /*
   * Progressive enhancement of the search form: results update as the learner
   * types, without reloading the page (so the field keeps focus). Without
   * JavaScript the form submits as a plain GET. Listeners are delegated because
   * the live refresh replaces the page content.
   */
  const SEARCH = 'form[data-catalog-search]';
  const RESULTS = '[data-catalog-results]';
  const DEBOUNCE_MS = 250;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let controller: AbortController | undefined;

  /** A new search keeps the theme and starts on page 1, on the page the form belongs to. */
  function searchUrl(form: HTMLFormElement): string {
    const data = new FormData(form);
    const base = (form.getAttribute('action') === '/projects' ? '/projects' : '/courses') as CatalogBase;
    return catalogHref(base, {
      theme: String(data.get('theme') ?? '') || undefined,
      recommended: data.get('recommended') === '1',
      q: String(data.get('q') ?? '').trim(),
    });
  }

  async function update(url: string) {
    controller?.abort();
    controller = new AbortController();
    try {
      const response = await fetch(url, { signal: controller.signal, headers: { Accept: 'text/html' } });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const next = new DOMParser().parseFromString(await response.text(), 'text/html').querySelector(RESULTS);
      const current = document.querySelector(RESULTS);
      if (!next || !current) throw new Error('Results not found');
      current.replaceWith(document.importNode(next, true));
      history.replaceState(history.state, '', url);
      const status = document.querySelector('[data-catalog-status]');
      const count = document.querySelector('[data-catalog-count]')?.textContent?.trim() ?? '';
      if (status) {
        status.textContent = '';
        // A fresh text node makes screen readers announce repeated messages.
        setTimeout(() => (status.textContent = count), 50);
      }
    } catch (error) {
      // Anything unexpected: fall back to a normal page load of the same search.
      if ((error as Error).name !== 'AbortError') location.assign(url);
    }
  }

  function searchForm(event: Event): HTMLFormElement | null {
    return (event.target as Element | null)?.closest?.<HTMLFormElement>(SEARCH) ?? null;
  }

  document.addEventListener('input', (event) => {
    const form = searchForm(event);
    if (!form) return;
    clearTimeout(timer);
    timer = setTimeout(() => void update(searchUrl(form)), DEBOUNCE_MS);
  });

  // The recommended checkbox applies at once, like the search.
  document.addEventListener('change', (event) => {
    const form = searchForm(event);
    if (!form) return;
    clearTimeout(timer);
    void update(searchUrl(form));
  });

  document.addEventListener('submit', (event) => {
    const form = searchForm(event);
    if (!form) return;
    event.preventDefault();
    clearTimeout(timer);
    void update(searchUrl(form));
  });
</script>

<style>
  .catalog-search {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    max-width: 48rem;
  }

  /* Toggle next to the search: a square box that fills amber (the "Recommended" cue of the cards) with a check. */
  .catalog-search__recommended {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    cursor: pointer;
  }

  .catalog-search__recommended input {
    appearance: none;
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .catalog-search__recommended input::after {
    content: '';
    width: 0.3rem;
    height: 0.6rem;
    margin-top: -0.1rem;
    border: solid var(--color-text);
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg) scale(0);
    transition: transform 0.15s ease;
  }

  .catalog-search__recommended input:hover {
    border-color: var(--color-spark);
  }

  .catalog-search__recommended input:checked {
    border-color: var(--color-spark);
    background: var(--color-spark);
  }

  .catalog-search__recommended input:checked::after {
    transform: rotate(45deg) scale(1);
  }

  .catalog-search__recommended input:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .catalog-search__field {
    display: flex;
    flex: 1 1 20rem;
    gap: var(--space-2);
    max-width: 32rem;
  }

  .catalog-search__input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) var(--space-5);
    border: 2px solid transparent;
    border-radius: var(--bubble-md);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .catalog-search__input:hover {
    border-color: var(--color-border-strong);
  }

  .catalog-search__input::placeholder {
    color: var(--color-text-muted);
  }

  .catalog-search__button {
    padding: var(--space-3) var(--space-5);
    border: 0;
    border-radius: var(--bubble-you-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: inherit;
    font-weight: var(--weight-extrabold);
    cursor: pointer;
  }

  .catalog-search__button:hover {
    background: var(--color-accent-strong);
  }

  .theme-filters,
  .pager ul {
    padding: 0;
    list-style: none;
  }

  /* Coloured like the theme badges on the cards (tone classes in tokens.css). */
  .theme-filter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: 2px solid transparent;
    border-radius: var(--bubble-md);
    background: var(--color-theme-badge-bg);
    color: var(--color-theme-badge-text);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  /* "All" is not a theme: neutral, so it never reads as the first theme's colour. */
  .theme-filter--all {
    --color-theme-badge-bg: var(--color-surface);
    --color-theme-badge-text: var(--color-text);
    --color-theme-fill: var(--color-ink);
    --color-on-theme-fill: var(--color-on-ink);
  }

  .theme-filter:hover {
    border-color: var(--color-theme-fill);
  }

  .theme-filter[aria-current] {
    border-color: var(--color-theme-fill);
    background: var(--color-theme-fill);
    color: var(--color-on-theme-fill);
  }

  /* Solid chip in the theme's strong colour; inverted on the selected (filled) badge. */
  .theme-filter__count {
    min-width: 1.6em;
    padding: 0 0.45em;
    border-radius: var(--radius-pill);
    background: var(--color-theme-fill);
    color: var(--color-on-theme-fill);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: 1.6;
    text-align: center;
  }

  .theme-filter[aria-current] .theme-filter__count {
    background: var(--color-on-theme-fill);
    color: var(--color-theme-fill);
  }

  .pager__link {
    display: inline-block;
    min-width: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 2px solid transparent;
    border-radius: var(--bubble-md);
    background: var(--color-surface);
    text-align: center;
    text-decoration: none;
  }

  a.pager__link:hover {
    border-color: var(--color-accent);
  }

  .pager__link[aria-current] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .pager__link[aria-disabled] {
    color: var(--color-text-muted);
  }

  .pager__gap {
    color: var(--color-text-muted);
  }

  /* The cards come from the page (slot): one bubble per item, the same width in every catalog. */
  .catalog-list {
    --grid-min: 20rem;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .catalog-list > :global(li) {
    display: flex;
    max-width: none;
  }

  .catalog-list > :global(li > *) {
    flex: 1;
  }
</style>
