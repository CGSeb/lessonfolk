{
  "name": "@lessonfolk/mcp",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The LessonFolk MCP server (Streamable HTTP at /mcp): course and progress tools for any AI chat.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.db.test.ts\"",
    "check": "tsc --noEmit",
    "plugin:sync": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-plugin-skills.ts",
    "plugin:openai": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-openai-plugin.ts"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@lessonfolk/core": "*",
    "@lessonfolk/db": "*",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "^1.7.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
