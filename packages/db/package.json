{
  "name": "@lessonfolk/db",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Postgres schema, migrations and database test helpers for LessonFolk.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env --experimental-strip-types --disable-warning=ExperimentalWarning src/migrate-cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.db.test.ts\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
